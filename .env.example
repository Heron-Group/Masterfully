# Copy to .env (or set in Plesk > Node.js > Custom environment variables).

# --- Sign-in ----------------------------------------------------------------
# Public address of the app, used for the Google/Microsoft redirect URIs.
APP_URL=https://research.example.com
# At least 32 random characters. Signs session cookies and encrypts users'
# AI keys: changing it signs everyone out and they must re-enter their keys.
# Generate with: npm run session-secret
SESSION_SECRET=

# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# (Web application). Redirect URI: https://research.example.com/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft: entra.microsoft.com > App registrations > New registration (Web).
# Redirect URI: https://research.example.com/api/auth/microsoft/callback
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
# "common" (work, school and personal accounts), "consumers", "organizations" or a tenant ID.
AUTH_MICROSOFT_TENANT=common

# Your own email address. The content from before multi-user moves into
# your workspace the first time you sign in with this (verified) address.
OWNER_EMAIL=

# --- Content repository -----------------------------------------------------
# Absolute path, outside the web root. Created (or cloned from the remote) on first run.
CONTENT_DIR=/var/www/vhosts/example.com/research-content
# Private GitHub repo for backup. Leave empty to keep content local only.
CONTENT_GIT_REMOTE=git@github.com:your-account/research-content.git
CONTENT_GIT_BRANCH=main
# SSH deploy key with write access to that one repo only.
GIT_SSH_KEY_PATH=/var/www/vhosts/example.com/.ssh/research_content_deploy
# Seconds to wait after the last change before pushing.
GIT_PUSH_DELAY_SECONDS=60
# Name and email on content commits.
GIT_AUTHOR_NAME=Masterfully
GIT_AUTHOR_EMAIL=masterfully@localhost

# --- Caches and secrets -----------------------------------------------------
# Thumbnails and other rebuildable files. Outside the content repo.
CACHE_DIR=/var/www/vhosts/example.com/research-cache
# Users' encrypted AI API keys. Outside the content repo and the web root;
# back it up separately if you like (users can always re-enter their keys).
SECRETS_DIR=/var/www/vhosts/example.com/research-secrets

# AI summaries use each user's own Claude or OpenAI key, added in Settings.
